{% extends 'base.html.twig' %}

{% block title %}Les photos de {{ categorie.titre }}{% endblock %}

{% block body %}
    <h1>Les photos de {{ categorie.titre }}</h1>
    <p>{{ categorie.description }}</p>
    <div class="row">
        {% if chatons.count==0 %}
            <p>Aucune photo dans cette catégorie</p>
        {% endif %}

        {% for chaton in chatons %}
            <div class="col-3">
                <div class="card" style="width: 18rem;">
                    <img class="card-img-top" src="{{ asset(chaton.urlPhoto) }}">
                    <div class="card-body">
                        <h5 class="card-title">{{ chaton.nom }}</h5>
                        <h6>{{ chaton.dateDeNaissance|date("d/m/Y") }}</h6>
                        <p class="card-text">{{ chaton.description }}</p>
                        <p class="card-text">(
                        {% for proprietaire in chaton.proprietaires %}
                            {{ proprietaire.nom }} {{ proprietaire.prenom }}
                            {% if not loop.last %}, {% endif %}
                        {% endfor %}
                        )</p>
                        <a href="{{ path("app_modifier_chaton", {"id": chaton.id}) }}" class="btn btn-sm btn-primary">Modifier</a>
                        <a href="{{ path("app_supprimer_chaton", {"id": chaton.id}) }}" class="btn btn-sm btn-danger">Supprimer</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    <a class="btn btn-primary mt-3" href="{{ path("app_ajouter_chaton") }}">Ajouter un chaton</a>
{% endblock %}
